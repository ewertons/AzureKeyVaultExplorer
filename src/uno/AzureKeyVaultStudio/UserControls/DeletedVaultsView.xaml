<UserControl
    x:Class="AzureKeyVaultStudio.UserControls.DeletedVaultsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AzureKeyVaultStudio.UserControls.ViewModels"
    d:DesignHeight="500"
    d:DesignWidth="860"
    mc:Ignorable="d">
    <Grid Padding="16,10" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Uid="DeletedVaultsTitle"
            Grid.Row="0"
            Style="{ThemeResource SubtitleTextBlockStyle}" />

        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="6">
            <Button Command="{x:Bind ViewModel.LoadCommand}" ToolTipService.ToolTip="Refresh (F5)">
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5" />
                </Button.KeyboardAccelerators>
            </Button>
            <Button
                x:Uid="RecoverButton"
                Command="{x:Bind ViewModel.RecoverCommand}"
                CommandParameter="{x:Bind ViewModel.SelectedItem, Mode=OneWay}" />
            <Button
                x:Uid="PurgeButton"
                Command="{x:Bind ViewModel.PurgeCommand}"
                CommandParameter="{x:Bind ViewModel.SelectedItem, Mode=OneWay}" />
        </StackPanel>

        <InfoBar
            Grid.Row="2"
            IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
            Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}" />

        <Grid
            Grid.Row="3"
            Padding="12,0"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="DeletedItemsNameHeader" Grid.Column="0" FontWeight="SemiBold" />
            <TextBlock x:Uid="DeletedVaultsResourceGroupHeader" Grid.Column="1" FontWeight="SemiBold" />
            <TextBlock x:Uid="DeletedVaultsLocationHeader" Grid.Column="2" FontWeight="SemiBold" />
            <TextBlock x:Uid="DeletedItemsDeletedHeader" Grid.Column="3" FontWeight="SemiBold" />
            <TextBlock x:Uid="DeletedItemsPurgeHeader" Grid.Column="4" FontWeight="SemiBold" />
        </Grid>

        <Grid Grid.Row="4">
            <ListView
                ItemsSource="{x:Bind ViewModel.Items}"
                SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeletedVaultItem">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <FontIcon
                                    FontSize="12"
                                    Glyph="&#xE72E;"
                                    Visibility="{x:Bind PurgeProtectionEnabled, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind ResourceGroup}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Location}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind DeletedOnText}" />
                            <TextBlock Grid.Column="4" Text="{x:Bind ScheduledPurgeOnText}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.EmptyText}"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            <ProgressRing
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
