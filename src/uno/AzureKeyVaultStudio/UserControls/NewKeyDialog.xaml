<UserControl
    x:Class="AzureKeyVaultStudio.UserControls.NewKeyDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AzureKeyVaultStudio.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="700"
    d:DesignWidth="640"
    mc:Ignorable="d">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Padding="16,0">
            <StackPanel
                Margin="10"
                Orientation="Vertical"
                Spacing="10">
                <TextBlock
                    x:Uid="NewKeyTitle"
                    Margin="2,10,0,0"
                    Style="{ThemeResource SubtitleTextBlockStyle}" />

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error" />

                <StackPanel Spacing="4">
                    <TextBlock x:Uid="KeyNameTextBlock" />
                    <TextBox x:Uid="NewKeyNameTextBox" Text="{x:Bind ViewModel.Name, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock x:Uid="VaultLocationTextBlock" />
                    <TextBox IsEnabled="False" Text="{x:Bind ViewModel.VaultUri}" />
                </StackPanel>

                <controls:WrapPanel HorizontalSpacing="16" VerticalSpacing="8">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="KeyTypeTextBlock" />
                        <ComboBox
                            MinWidth="140"
                            DisplayMemberPath="Label"
                            ItemsSource="{x:Bind ViewModel.KindOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedKind, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsRsa, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock x:Uid="KeySizeTextBlock" />
                        <ComboBox
                            MinWidth="120"
                            ItemsSource="{x:Bind ViewModel.KeySizes}"
                            SelectedItem="{x:Bind ViewModel.SelectedKeySize, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsEc, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock x:Uid="KeyCurveTextBlock" />
                        <ComboBox
                            MinWidth="120"
                            ItemsSource="{x:Bind ViewModel.Curves}"
                            SelectedItem="{x:Bind ViewModel.SelectedCurve, Mode=TwoWay}" />
                    </StackPanel>
                </controls:WrapPanel>

                <StackPanel Spacing="4">
                    <TextBlock x:Uid="KeyOperationsTextBlock" />
                    <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="4">
                        <CheckBox
                            Content="sign"
                            IsChecked="{x:Bind ViewModel.OpSign, Mode=TwoWay}" />
                        <CheckBox
                            Content="verify"
                            IsChecked="{x:Bind ViewModel.OpVerify, Mode=TwoWay}" />
                        <CheckBox
                            Content="encrypt"
                            IsChecked="{x:Bind ViewModel.OpEncrypt, Mode=TwoWay}"
                            Visibility="{x:Bind ViewModel.IsRsa, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <CheckBox
                            Content="decrypt"
                            IsChecked="{x:Bind ViewModel.OpDecrypt, Mode=TwoWay}"
                            Visibility="{x:Bind ViewModel.IsRsa, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <CheckBox
                            Content="wrapKey"
                            IsChecked="{x:Bind ViewModel.OpWrapKey, Mode=TwoWay}"
                            Visibility="{x:Bind ViewModel.IsRsa, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <CheckBox
                            Content="unwrapKey"
                            IsChecked="{x:Bind ViewModel.OpUnwrapKey, Mode=TwoWay}"
                            Visibility="{x:Bind ViewModel.IsRsa, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </controls:WrapPanel>
                </StackPanel>

                <StackPanel Spacing="8">
                    <CheckBox x:Uid="SetActivationDateCheckbox" IsChecked="{x:Bind ViewModel.HasActivationDate, Mode=TwoWay}">
                        <TextBlock x:Uid="SetActivationDateTextBlock" />
                    </CheckBox>
                    <DatePicker SelectedDate="{x:Bind ViewModel.NotBefore, Mode=TwoWay}" Visibility="{x:Bind ViewModel.HasActivationDate, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <CheckBox x:Uid="SetExpirationDateCheckbox" IsChecked="{x:Bind ViewModel.HasExpirationDate, Mode=TwoWay}">
                        <TextBlock x:Uid="SetExpirationDateTextBlock" />
                    </CheckBox>
                    <DatePicker SelectedDate="{x:Bind ViewModel.ExpiresOn, Mode=TwoWay}" Visibility="{x:Bind ViewModel.HasExpirationDate, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock x:Uid="EnabledTextBlock" VerticalAlignment="Center" />
                    <ToggleSwitch
                        x:Uid="EnabledToggleSwitch"
                        VerticalAlignment="Center"
                        IsOn="{x:Bind ViewModel.Enabled, Mode=TwoWay}" />
                </StackPanel>

                <local:TagsEditor EditableTags="{x:Bind ViewModel.EditableTags, Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>

        <Grid
            Grid.Row="1"
            MinHeight="80"
            Padding="24,0"
            VerticalAlignment="Bottom"
            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.CreateCommand}"
                Style="{ThemeResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" />
                    <TextBlock x:Uid="NewItemSubmitButtonText" />
                    <ProgressRing
                        Width="14"
                        Height="14"
                        IsActive="{x:Bind ViewModel.CreateCommand.IsRunning, Mode=OneWay}" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Click="CancelButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE711;" />
                    <TextBlock x:Uid="CancelTextBlock" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
