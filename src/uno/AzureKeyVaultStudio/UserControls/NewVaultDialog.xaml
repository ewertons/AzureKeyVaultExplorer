<UserControl
    x:Class="AzureKeyVaultStudio.UserControls.NewVaultDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AzureKeyVaultStudio.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="760"
    d:DesignWidth="640"
    mc:Ignorable="d">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Padding="16,0">
            <StackPanel
                Margin="10"
                Orientation="Vertical"
                Spacing="10">
                <TextBlock
                    x:Uid="NewVaultTitle"
                    Margin="2,10,0,0"
                    Style="{ThemeResource SubtitleTextBlockStyle}" />

                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error" />

                <StackPanel Spacing="4">
                    <TextBlock x:Uid="VaultSubscriptionTextBlock" />
                    <TextBox IsEnabled="False" Text="{x:Bind ViewModel.SubscriptionName}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock x:Uid="VaultResourceGroupTextBlock" />
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        DisplayMemberPath="Name"
                        IsEnabled="{x:Bind ViewModel.IsResourceGroupEditable}"
                        ItemsSource="{x:Bind ViewModel.ResourceGroups}"
                        SelectedItem="{x:Bind ViewModel.SelectedResourceGroup, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock x:Uid="VaultNameTextBlock" />
                    <TextBox
                        x:Uid="NewVaultNameTextBox"
                        MaxLength="24"
                        Text="{x:Bind ViewModel.Name, Mode=TwoWay}" />
                </StackPanel>

                <controls:WrapPanel HorizontalSpacing="16" VerticalSpacing="8">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="VaultRegionTextBlock" />
                        <ComboBox
                            MinWidth="240"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{x:Bind ViewModel.Locations}"
                            SelectedItem="{x:Bind ViewModel.SelectedLocation, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="VaultPricingTierTextBlock" />
                        <ComboBox
                            MinWidth="140"
                            ItemsSource="{x:Bind ViewModel.SkuOptions}"
                            SelectedIndex="{x:Bind ViewModel.SelectedSkuIndex, Mode=TwoWay}" />
                    </StackPanel>
                </controls:WrapPanel>

                <StackPanel Spacing="4">
                    <TextBlock x:Uid="VaultPermissionModelTextBlock" />
                    <ToggleSwitch x:Uid="VaultRbacToggleSwitch" IsOn="{x:Bind ViewModel.UseRbacAuthorization, Mode=TwoWay}" />
                </StackPanel>

                <CheckBox Content="{x:Bind ViewModel.GrantAccessText, Mode=OneWay}" IsChecked="{x:Bind ViewModel.GrantCurrentUserAccess, Mode=TwoWay}" />

                <controls:WrapPanel HorizontalSpacing="16" VerticalSpacing="8">
                    <NumberBox
                        x:Uid="VaultRetentionNumberBox"
                        MinWidth="200"
                        LargeChange="10"
                        Maximum="90"
                        Minimum="7"
                        SmallChange="1"
                        SpinButtonPlacementMode="Compact"
                        Value="{x:Bind ViewModel.SoftDeleteRetentionInDays, Mode=TwoWay}" />
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="VaultPurgeProtectionTextBlock" />
                        <ToggleSwitch IsOn="{x:Bind ViewModel.EnablePurgeProtection, Mode=TwoWay}" />
                    </StackPanel>
                </controls:WrapPanel>

                <TextBlock
                    x:Uid="VaultPurgeProtectionHint"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />

                <local:TagsEditor EditableTags="{x:Bind ViewModel.EditableTags, Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>

        <Grid
            Grid.Row="1"
            MinHeight="80"
            Padding="24,0"
            VerticalAlignment="Bottom"
            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.CreateCommand}"
                Style="{ThemeResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" />
                    <TextBlock x:Uid="NewItemSubmitButtonText" />
                    <ProgressRing
                        Width="14"
                        Height="14"
                        IsActive="{x:Bind ViewModel.CreateCommand.IsRunning, Mode=OneWay}" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Click="CancelButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE711;" />
                    <TextBlock x:Uid="CancelTextBlock" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
